#!/usr/bin/env bash
# kctl-env kubectl shim
# Pure Bash, zero dependencies, fast version resolution

set -euo pipefail

# --- Bootstrap ---
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
default_root="$(cd -- "$script_dir/.." && pwd)"
KCTL_ENV_ROOT="${KCTL_ENV_ROOT:-$default_root}"

# Source shared functions (logging, version resolution helpers, cache)
# shellcheck source=../libexec/kctl-env-common
source "$KCTL_ENV_ROOT/libexec/kctl-env-common"

# --- Version Resolution ---
resolve_version() {
  # 1. Env var
  if [[ -n "${KCTL_VERSION:-}" ]]; then
    kctl_debug "version from KCTL_VERSION env: $KCTL_VERSION"
    echo "$KCTL_VERSION"
    return 0
  fi
  # 2. .kubectl-version (traverse up)
  local filever
  filever="$(find_kubectl_version_file 2>/dev/null || true)"
  if [[ -n "$filever" ]]; then
    echo "$filever"
    return 0
  fi
  # 3. Global version file
  if [[ -f "$KCTL_GLOBAL_VERSION_FILE" ]]; then
    local globalver
    read -r globalver < "$KCTL_GLOBAL_VERSION_FILE"
    if [[ "$globalver" == "auto" ]]; then
      kctl_debug "global version is auto; resolving via context"
      local context version
      context="$(get_current_context)" || { kctl_debug "auto mode: no context found, falling back to latest"; echo "latest"; return 0; }
      version="$(get_cached_version_for_context "$context" || true)"
      if [[ -n "$version" ]]; then
        echo "$version"
        return 0
      fi
      # Not cached: query, update cache
      version="$(query_server_version)"
      if [[ -n "$version" ]]; then
        update_cluster_map_cache "$context" "$version"
        echo "$version"
        return 0
      fi
      kctl_debug "auto mode: could not query server version, falling back to latest"
    else
      kctl_debug "global version: $globalver"
      echo "$globalver"
      return 0
    fi
  fi
  # 4. Fallback: latest
  kctl_debug "using fallback version: latest"
  echo "latest"
}

# --- Main ---
main() {
  local version resolved_bin
  version="$(resolve_version)"

  # Validate resolved version before constructing path
  if ! is_valid_version "$version"; then
    kctl_error "resolved version '$version' is invalid (source may be corrupted)"
    exit 1
  fi

  resolved_bin="$KCTL_VERSIONS/$version/kubectl"
  if [[ ! -x "$resolved_bin" ]]; then
    kctl_error "kubectl version '$version' not installed. Run: kctl-env install $version"
    exit 1
  fi
  exec "$resolved_bin" "$@"
}

main "$@"
