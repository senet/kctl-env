#!/usr/bin/env bash
set -euo pipefail

# kctl-env list — show locally installed kubectl versions
# Marks the active version with * and shows the source.

KCTL_ENV_ROOT="${KCTL_ENV_ROOT:-$HOME/.kctl-env}"
KCTL_VERSIONS="$KCTL_ENV_ROOT/versions"
KCTL_GLOBAL_VERSION_FILE="$KCTL_ENV_ROOT/version"
KCTL_CLUSTER_MAP="$KCTL_ENV_ROOT/cache/cluster-map"
KCTL_CLUSTER_TTL="${KCTL_CLUSTER_TTL:-300}"

# --- Resolve active version and its source ---

resolve_active_version() {
  # 1. KCTL_VERSION env var
  if [[ -n "${KCTL_VERSION:-}" ]]; then
    echo "$KCTL_VERSION"
    echo "KCTL_VERSION environment variable"
    return 0
  fi

  # 2. .kubectl-version file (traverse up from cwd)
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.kubectl-version" ]]; then
      cat "$dir/.kubectl-version"
      echo "$dir/.kubectl-version"
      return 0
    fi
    dir="$(dirname "$dir")"
  done

  # 3. Global version file
  if [[ -f "$KCTL_GLOBAL_VERSION_FILE" ]]; then
    local gv
    gv="$(cat "$KCTL_GLOBAL_VERSION_FILE")"
    echo "$gv"
    echo "$KCTL_GLOBAL_VERSION_FILE"
    return 0
  fi

  return 1
}

# --- Resolve auto mode via cluster-map cache (mirrors bin/kubectl logic) ---

get_current_context() {
  local config="$HOME/.kube/config"
  [[ -f "$config" ]] || return 1
  local ctx
  ctx="$(grep 'current-context:' "$config" | awk '{print $2}')"
  [[ -n "$ctx" ]] && echo "$ctx" && return 0
  return 1
}

get_cached_version_for_context() {
  local context="$1" now ts
  now=$(date +%s)
  [[ -f "$KCTL_CLUSTER_MAP" ]] || return 1
  while read -r c v t; do
    [[ "$c" != "$context" ]] && continue
    ts=${t:-0}
    if [[ $((now - ts)) -lt $KCTL_CLUSTER_TTL ]]; then
      echo "$v"
      return 0
    fi
  done < "$KCTL_CLUSTER_MAP"
  return 1
}

# Outputs two lines on success (line 1: resolved version, line 2: kube context name)
# and returns 0, or returns 1 when context or cached version cannot be determined.
resolve_auto() {
  local context cached_version
  context="$(get_current_context)" || return 1
  cached_version="$(get_cached_version_for_context "$context")" || return 1
  echo "$cached_version"
  echo "$context"
  return 0
}

# --- Resolve keywords (latest/stable) to actual v* directory ---

resolve_keyword() {
  local keyword="$1"
  case "$keyword" in
    latest)
      # latest is typically a symlink; resolve its target name
      if [[ -L "$KCTL_VERSIONS/latest" ]]; then
        local target
        target="$(readlink "$KCTL_VERSIONS/latest")"
        basename "$target"
        return 0
      fi
      ;;
    stable)
      # stable treated same as latest
      if [[ -L "$KCTL_VERSIONS/latest" ]]; then
        local target
        target="$(readlink "$KCTL_VERSIONS/latest")"
        basename "$target"
        return 0
      fi
      ;;
  esac
  return 1
}

# --- Main ---

if [[ ! -d "$KCTL_VERSIONS" ]]; then
  echo "No versions installed. Run: kctl-env install <version>" >&2
  exit 0
fi

# Collect installed v* versions (sorted descending, portable)
versions=()
while IFS= read -r v; do
  versions+=("$v")
done < <(
  raw_versions="$(ls -1 "$KCTL_VERSIONS" 2>/dev/null | grep -E '^v')"
  if sort -V </dev/null >/dev/null 2>&1; then
    # GNU sort available (Linux / newer macOS with coreutils)
    printf '%s\n' "$raw_versions" | sort -Vr
  else
    # POSIX fallback: sort semantic versions, including pre-releases.
    # Stable releases sort above pre-releases for the same MAJOR.MINOR.PATCH,
    # and rc.N pre-releases sort numerically among themselves.
    printf '%s\n' "$raw_versions" |
      awk '
        {
          ver = $0
          norm = ver
          sub(/^v/, "", norm)

          prerelease = ""
          split(norm, parts, "-")
          core = parts[1]
          if (length(norm) > length(core)) {
            prerelease = substr(norm, length(core) + 2)
          }

          split(core, nums, ".")
          major = nums[1] + 0
          minor = nums[2] + 0
          patch = nums[3] + 0

          stable_rank = 1
          prerelease_rank = -1
          prerelease_label = ""

          if (prerelease != "") {
            stable_rank = 0
            prerelease_label = prerelease
            if (prerelease ~ /^rc\.[0-9]+$/) {
              split(prerelease, rc_parts, ".")
              prerelease_rank = rc_parts[2] + 0
            }
          }

          printf "%s\t%d\t%d\t%d\t%d\t%d\t%s\n", ver, major, minor, patch, stable_rank, prerelease_rank, prerelease_label
        }
      ' |
      sort -t "$(printf '\t')" -k2,2nr -k3,3nr -k4,4nr -k5,5nr -k6,6nr -k7,7r |
      awk -F "$(printf '\t')" '{ print $1 }'
  fi
)

if [[ ${#versions[@]} -eq 0 ]]; then
  echo "No versions installed. Run: kctl-env install <version>" >&2
  exit 0
fi

# Determine active version
active_version=""
active_source=""
auto_note=""
if result="$(resolve_active_version)"; then
  active_version="$(echo "$result" | head -n1)"
  active_source="$(echo "$result" | tail -n1)"

  # If the active version is a keyword, resolve it
  case "$active_version" in
    auto)
      if auto_result="$(resolve_auto 2>/dev/null)"; then
        auto_ver="$(echo "$auto_result" | head -n1)"
        auto_ctx="$(echo "$auto_result" | tail -n1)"
        active_source="$active_source → auto (context: $auto_ctx)"
        active_version="$auto_ver"
      else
        # Cannot resolve to a specific version; annotate and suppress the * marker
        auto_ctx="$(get_current_context 2>/dev/null || true)"
        populate_hint="run kubectl to populate cache"
        if [[ -n "$auto_ctx" ]]; then
          auto_note="  active: auto (context: $auto_ctx, no cached version — $populate_hint)"
        else
          auto_note="  active: auto (no kube context found — $populate_hint)"
        fi
        active_version=""
      fi
      ;;
    latest|stable)
      resolved="$(resolve_keyword "$active_version" 2>/dev/null || true)"
      if [[ -n "$resolved" ]]; then
        active_source="$active_source → $active_version"
        active_version="$resolved"
      fi
      ;;
  esac
fi

# Print each version with marker
for v in "${versions[@]}"; do
  if [[ "$v" == "$active_version" && -n "$active_version" ]]; then
    printf "* %s (set by %s)\n" "$v" "$active_source"
  else
    printf "  %s\n" "$v"
  fi
done

[[ -n "$auto_note" ]] && echo "$auto_note"
